{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "node /Users/tiagoalves/workspace/github.com/dotfiles/agent-guardrails/firestore-guard.js --tool=cursor --event=shell",
        "failClosed": true
      }
    ],
    "beforeMCPExecution": [
      {
